# Include inside the HTTPS server block, separately from /pokerbench/.
location = /pokerbench-stats {
    return 308 https://$host/pokerbench-stats/;
}
location ^~ /pokerbench-stats/ {
    if ($scheme != "https") { return 308 https://$host$request_uri; }
    limit_req zone=pokerbench_stats_ip burst=5 nodelay;
    limit_req_status 429;
    client_max_body_size 1k;
    proxy_pass http://127.0.0.1:8101/;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_cache off;
    proxy_connect_timeout 2s;
    proxy_read_timeout 5s;
}
# Define in an http{} context: limit_req_zone $binary_remote_addr zone=pokerbench_stats_ip:1m rate=2r/s;
